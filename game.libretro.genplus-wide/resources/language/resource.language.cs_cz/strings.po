msgctxt "#30102"
msgid "Specify which add-on to use for CD audio playback with supported Mega Drive/Genesis games."
msgstr "Určuje doplněk použitý k přehrávání zvuku CD v podporovaných hrách Mega Drive/Genesis."

msgctxt "#30103"
msgid "Sega/Mega CD"
